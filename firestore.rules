rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    match /merchants/{merchantId} {
      allow create: if signedIn() && request.auth.uid == merchantId;
      allow read, update: if signedIn() && request.auth.uid == merchantId;
      allow delete: if false;
    }
    match /merchants/{merchantId}/paymentLinks/{linkId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == merchantId;
    }
    match /merchants/{merchantId}/transactions/{transactionId} {
      allow read: if signedIn() && request.auth.uid == merchantId;
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
