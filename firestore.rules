rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function merchantExists() { return signedIn() && exists(/databases/$(database)/documents/merchants/$(request.auth.uid)); }
    function ownMerchant() { return get(/databases/$(database)/documents/merchants/$(request.auth.uid)); }
    function isPositiveMinorAmount(value) { return value is int && value > 0 && value <= 100000000000; }
    function isOpenPaymentStatus(value) { return value == 'created' || value == 'awaiting_customer'; }

    match /merchants/{uid} {
      allow create: if isOwner(uid)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.environment == 'sandbox'
        && request.resource.data.currency == 'APX'
        && request.resource.data.protocolVersion == '1.0';
      allow get: if isOwner(uid);
      allow list: if false;
      allow update: if isOwner(uid)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.merchantId == resource.data.merchantId
        && request.resource.data.status == resource.data.status
        && request.resource.data.environment == resource.data.environment
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.protocolVersion == resource.data.protocolVersion;
      allow delete: if false;
    }

    match /publicMerchants/{merchantId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if merchantExists()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.merchantId == merchantId
        && ownMerchant().data.merchantId == merchantId
        && request.resource.data.businessName == ownMerchant().data.businessName
        && request.resource.data.status == ownMerchant().data.status
        && request.resource.data.currency == 'APX'
        && request.resource.data.protocolVersion == '1.0';
      allow delete: if false;
    }

    match /wallets/{uid} {
      // Every app may bootstrap only its own empty wallet. There is no client-side
      // operation that can choose an opening balance.
      allow create: if isOwner(uid)
        && request.resource.data.ownerUid == request.auth.uid
        && (request.resource.data.ownerType == 'merchant' || request.resource.data.ownerType == 'customer')
        && request.resource.data.currency == 'APX'
        && request.resource.data.availableBalanceMinor == 0
        && request.resource.data.pendingBalanceMinor == 0
        && request.resource.data.status == 'active'
        && request.resource.data.protocolVersion == '1.0';
      allow get: if isOwner(uid);
      allow list: if false;
      // Balance movement is intentionally disabled until the atomic Wallet settlement
      // contract is deployed. Profile clients cannot update wallet documents.
      allow update, delete: if false;
    }

    match /paymentIntents/{paymentId} {
      allow create: if merchantExists()
        && request.resource.data.merchantUid == request.auth.uid
        && request.resource.data.merchantId == ownMerchant().data.merchantId
        && request.resource.data.merchantName == ownMerchant().data.businessName
        && request.resource.data.currency == 'APX'
        && request.resource.data.protocolVersion == '1.0'
        && request.resource.data.status == 'created'
        && isPositiveMinorAmount(request.resource.data.amountMinor)
        && request.resource.data.reference is string
        && request.resource.data.reference.size() >= 3
        && request.resource.data.reference.size() <= 120
        && request.resource.data.token is string
        && request.resource.data.token.size() >= 32;
      allow get: if (merchantExists() && resource.data.merchantUid == request.auth.uid)
        || isOpenPaymentStatus(resource.data.status);
      allow list: if merchantExists() && resource.data.merchantUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Canonical financial history remains immutable/unavailable to ordinary clients
    // until the Wallet settlement rule set is installed.
    match /customers/{id} { allow read, write: if false; }
    match /transactions/{id} { allow read, write: if false; }
    match /ledgerEntries/{id} { allow read, write: if false; }
    match /treasuryOperations/{id} { allow read, write: if false; }
    match /adminUsers/{id} { allow read, write: if false; }
    match /auditEvents/{id} { allow read, write: if false; }
    match /protocol/{id} { allow read: if true; allow write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
